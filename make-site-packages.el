;;; extract3.el --- build the host package manifest -*- lexical-binding: t -*-
;; Usage: emacs -q --batch -l extract3.el <init.el> <custom-file> <out-file>
;;
;; Supersedes extract2.el, which scanned with a regex plus `forward-sexp' and
;; silently included a package whenever `forward-sexp' errored (the body came
;; back empty, so the :ensure-nil / :disabled tests never matched).  This reads
;; the file with `read', so every use-package form is inspected structurally.
;;
;; Sources, in order of authority:
;;   init.el  :vc declarations   -> package-vc installs   (authoritative)
;;   init.el  use-package names  -> archive installs
;;   custom-file selected-pkgs   -> unioned in, but only for names init.el
;;                                  does not mark :ensure nil / :disabled
;;   custom-file vc specs        -> merged, minus names no longer in init.el

(require 'cl-lib)
(require 'seq)

(defun ex3--plist-get* (body kw)
  "Value following KW in use-package BODY (a plist-ish tail), or :absent."
  (let ((tail body) (res :absent))
    (while tail
      (when (eq (car tail) kw) (setq res (cadr tail) tail nil))
      (setq tail (cdr tail)))
    res))

(defun ex3--vc-url (spec)
  "Turn a vc-use-package SPEC into a package-vc :url string.
SPEC may be either a bare plist, (:fetcher \"github\" :repo \"o/r\"), or a
named one, (NAME :fetcher github :repo \"o/r\").  `plist-get' reads keys at
even indices only, so the leading NAME in the second shape shifts every
key onto an odd index and makes the whole plist invisible; drop it first."
  (let* ((spec (if (and (consp spec) (car spec) (not (keywordp (car spec))))
                   (cdr spec)
                 spec))
         (repo (plist-get spec :repo))
         (url  (plist-get spec :url)))
    (cond (url url)
          ((and repo (string-prefix-p "http" repo)) repo)
          (repo (concat "https://github.com/" repo)))))

(defun ex3--scan-init (file)
  "Return (ARCHIVE-NAMES VC-ALIST SUPPRESSED UNRESOLVED) from FILE."
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (let (archive vc suppressed unresolved)
      (cl-labels
          ((visit (form outer-disabled)
             ;; Recurse through every sub-form, not just top-level ones:
             ;; init.el wraps a dozen use-package declarations in `when' or
             ;; `let' (eww-lnum, spotify, calfw-org...).  A top-level-only
             ;; scan misses them, and they then install into every user's
             ;; personal overlay at startup instead of the host tree.
             (when (consp form)
               (if (eq (car form) 'use-package)
                   (let* ((name (nth 1 form))
                          (body (nthcdr 2 form))
                          (disabled (or outer-disabled
                                        (not (eq (ex3--plist-get* body :disabled)
                                                 :absent))))
                          (ensure   (ex3--plist-get* body :ensure))
                          (vcspec   (ex3--plist-get* body :vc)))
                     (cond
                      ;; a :vc declaration always wins -- installed from git
                      ((not (eq vcspec :absent))
                       (let ((url (ex3--vc-url vcspec)))
                         (cond ((and url (not disabled)) (push (cons name url) vc))
                               ;; A :vc form we cannot turn into a URL is
                               ;; dropped from every list below.  Record it so
                               ;; the drop is reported instead of silent.
                               ((not disabled) (push name unresolved)))))
                      ;; built-in or vendored: never install from an archive
                      ((or disabled (null ensure))
                       (push name suppressed))
                      (t (push name archive)))
                     ;; a use-package body may itself nest more of them
                     (walk-tail body disabled))
                 (walk-tail form outer-disabled))))
           (walk-tail (tail disabled)
             ;; `dolist' would do, except init.el is full of dotted pairs
             ;; (archive alists, auto-mode-alist entries...) and dolist
             ;; requires a proper list.  Stop at the first non-cons cdr.
             (while (consp tail)
               (visit (car tail) disabled)
               (setq tail (cdr tail)))))
        (condition-case nil
            (while t (visit (read (current-buffer)) nil))
          (end-of-file nil)))
      (setq archive (delete-dups (nreverse archive))
            vc      (nreverse vc))
      ;; A name is only suppressed if NO live form asks for it.  init.el
      ;; carries several packages twice -- one live form and one long-dead
      ;; :disabled copy -- and without this filter the dead copy subtracts
      ;; the live one at the seq-difference below (this is what silently
      ;; dropped `yankpad' from the manifest).
      (list archive vc
            (seq-difference (delete-dups (nreverse suppressed))
                            (append archive (mapcar #'car vc)))
            (delete-dups (nreverse unresolved))))))

(defun ex3--custom-lists (file)
  (let (selected vc)
    (when (file-exists-p file)
      (with-temp-buffer
        (insert-file-contents file)
        (goto-char (point-min))
        (dolist (e (cdr (read (current-buffer))))
          (let* ((entry (cadr e)) (var (car entry)) (val (cadr entry)))
            (when (and (consp val) (eq (car val) 'quote))
              (cond ((eq var 'package-selected-packages)    (setq selected (cadr val)))
                    ((eq var 'package-vc-selected-packages) (setq vc       (cadr val)))))))))
    (cons selected vc)))

(let* ((init   (nth 0 command-line-args-left))
       (custom (nth 1 command-line-args-left))
       (out    (nth 2 command-line-args-left))
       (scan   (ex3--scan-init init))
       (archive    (nth 0 scan))
       (init-vc    (nth 1 scan))
       (suppressed (nth 2 scan))
       (unresolved (nth 3 scan))
       (cl       (ex3--custom-lists custom))
       (selected (copy-sequence (car cl)))
       (custom-vc (cdr cl))
       ;; custom-file vc specs, but only for packages init.el still declares
       ;; init.el bootstraps vc-use-package with a bare `package-vc-install'
       ;; call, before use-package is configured, so no use-package form
       ;; declares it and the scan above cannot see it.  It is not optional:
       ;; every `:vc (:fetcher "github" :repo ...)' form in init.el uses
       ;; vc-use-package's syntax, which built-in use-package does not
       ;; understand.  Without it in the host tree each user re-clones it
       ;; into their own overlay on first start.
       (init-vc (cons '(vc-use-package
                        . "https://github.com/slotThe/vc-use-package")
                      init-vc))
       (init-vc-names (mapcar #'car init-vc))
       (extra-vc (seq-filter
                  (lambda (s) (memq (if (consp s) (car s) s) init-vc-names))
                  custom-vc))
       (vc-names (delete-dups (append init-vc-names
                                      (mapcar (lambda (s) (if (consp s) (car s) s))
                                              extra-vc))))
       ;; init.el is the source of truth.  package-selected-packages is NOT
       ;; unioned in: with use-package-always-ensure every real package has a
       ;; use-package form, and the only names the custom-file adds beyond
       ;; that are stale (e.g. use-package-ensure-system-package, withdrawn
       ;; from every archive) or already covered as :vc packages.
       (all (seq-difference (delete-dups archive)
                            (append suppressed vc-names)))
       (sorted (sort (copy-sequence all) #'string<)))

  (with-temp-file out
    (insert ";;; site-packages.el --- host-wide Emacs package manifest -*- lexical-binding: t -*-\n\n")
    (insert ";; Generated by extract3.el from:\n;;   " init "\n;;   " custom "\n;;\n")
    (insert ";; Archive packages come from the use-package forms in init.el (skipping\n")
    (insert ";; :disabled and :ensure nil).  package-selected-packages is NOT unioned\n")
    (insert ";; in -- everything it adds beyond init.el is stale.\n")
    (insert ";; Git packages come from init.el's :vc declarations, which are the\n")
    (insert ";; authoritative list -- the custom-file's package-vc-selected-packages\n")
    (insert ";; lags behind it.  Dependencies resolve automatically.\n;;\n")
    (insert ";; Install/refresh the host set as any `emacs-admin' member -- no sudo:\n")
    (insert ";;   umask 002 && emacs -q --batch -l site-packages.el\n;;\n")
    (insert ";; The `umask 002' is load-bearing.  Without it the new package\n")
    (insert ";; directories land drwxr-sr-x and the *next* admin cannot update them.\n;;\n")
    (insert ";; The tree is world-readable; every user's Emacs activates it via\n")
    (insert ";; `package-directory-list' (set in early-init.el).  Write access is\n")
    (insert ";; limited to the `emacs-admin' group.  One-time setup, as root:\n;;\n")
    (insert ";;   groupadd emacs-admin\n")
    (insert ";;   usermod -a -G emacs-admin <user>          # needs a fresh login\n")
    (insert ";;   install -d -o root -g emacs-admin -m 2775 \\\n")
    (insert ";;           /usr/local/share/emacs/site-lisp/elpa\n;;\n")
    (insert ";; The setgid bit propagates ownership to everything installed beneath\n")
    (insert ";; it, so the chgrp/chmod never has to be repeated.\n;;\n")
    (insert ";; Users do NOT need group membership to use the packages -- only to\n")
    (insert ";; change the host set.  Per-user additions go to ~/.emacs.d/elpa.\n\n")

    (insert "(require 'package)\n(require 'seq)\n\n")
    (insert "(setq package-user-dir \"/usr/local/share/emacs/site-lisp/elpa/\"\n")
    (insert "      package-check-signature nil\n")
    (insert "      package-archives\n")
    (insert "      '((\"gnu\"          . \"https://elpa.gnu.org/packages/\")\n")
    (insert "        (\"non-gnu\"      . \"https://elpa.nongnu.org/nongnu/\")\n")
    (insert "        (\"melpa-stable\" . \"https://stable.melpa.org/packages/\")\n")
    (insert "        (\"melpa\"        . \"https://melpa.org/packages/\"))\n")
    (insert "      package-archive-priorities\n")
    (insert "      '((\"gnu\" . 5) (\"non-gnu\" . 3) (\"melpa-stable\" . 2) (\"melpa\" . 1)))\n\n")

    ;; vterm asks to compile its module at byte-compile time; a batch run on a
    ;; terminal would block on the prompt.  Decline non-interactively.
    (insert ";; Decline any interactive prompt raised during compilation (vterm asks\n")
    (insert ";; to build vterm-module and would otherwise block a terminal run).\n")
    (insert "(fset 'y-or-n-p (lambda (&rest _) nil))\n")
    (insert "(fset 'yes-or-no-p (lambda (&rest _) nil))\n\n")

    (insert (format "(defvar site-packages\n  '(  ; %d archive packages\n    " (length sorted)))
    (let ((col 4))
      (dolist (p sorted)
        (let ((s (symbol-name p)))
          (when (> (+ col (length s) 1) 76) (insert "\n    ") (setq col 4))
          (insert s " ") (setq col (+ col (length s) 1)))))
    (insert "))\n\n")

    (insert (format "(defvar site-vc-packages\n  '(  ; %d git packages\n" (length init-vc)))
    (dolist (spec (sort (copy-sequence init-vc)
                        (lambda (a b) (string< (car a) (car b)))))
      (insert (format "    (%s :url %S)\n" (car spec) (cdr spec))))
    (insert "))\n\n")

    (insert "(package-initialize)\n(package-refresh-contents)\n\n")
    (insert "(defvar site--skipped nil)\n(defvar site--failed nil)\n\n")
    (insert "(dolist (pkg site-packages)\n")
    (insert "  (cond\n")
    (insert "   ((package-installed-p pkg) nil)\n")
    (insert "   ((not (assq pkg package-archive-contents)) (push pkg site--skipped))\n")
    (insert "   (t (condition-case err (package-install pkg)\n")
    (insert "        (error (push (cons pkg (error-message-string err)) site--failed))))))\n\n")
    (insert "(dolist (spec site-vc-packages)\n")
    (insert "  (unless (package-installed-p (car spec))\n")
    (insert "    (condition-case err (package-vc-install spec)\n")
    (insert "      (error (push (cons (car spec) (error-message-string err)) site--failed)))))\n\n")
    ;; vterm ships a C module that package.el does not build.  Without it
    ;; every user is asked "Vterm needs `vterm-module' to work.  Compile it
    ;; now?" at startup -- and in a GUI session that prompt appears before
    ;; init.el finishes, swallowing keystrokes until it is answered.  Build
    ;; it once, host-wide, which is the whole point of a shared tree.
    (insert ";; Build vterm's C module; package.el does not, and its absence makes\n")
    (insert ";; every user answer a blocking prompt at startup.\n")
    (insert "(defvar site--vterm \"not present\")\n")
    (insert "(let ((vt (car (last (file-expand-wildcards\n")
    (insert "                      (expand-file-name \"vterm-*\" package-user-dir))))))\n")
    (insert "  (when vt\n")
    (insert "    (if (file-exists-p (expand-file-name \"vterm-module.so\" vt))\n")
    (insert "        (setq site--vterm \"already built\")\n")
    (insert "      (let ((default-directory (file-name-as-directory vt)))\n")
    (insert "        (setq site--vterm\n")
    (insert "              (if (zerop (call-process\n")
    (insert "                          \"sh\" nil nil nil \"-c\"\n")
    (insert "                          (concat \"mkdir -p build && cd build && \"\n")
    (insert "                                  \"cmake -DUSE_SYSTEM_LIBVTERM=OFF .. && make\")))\n")
    (insert "                  \"built\" \"BUILD FAILED\"))))))\n\n")
    ;; `umask 002' is not sufficient on its own: for tar-format packages
    ;; package.el applies the mode bits recorded in the archive tarball,
    ;; which land the package directory at 2755 -- unwritable by the rest
    ;; of emacs-admin, so the next admin cannot update or delete it.
    ;; Normalize every directory afterwards.  Files stay as they are;
    ;; removing a package needs write permission on the containing
    ;; directory, not on each file.
    (insert ";; Re-assert group-writability: package.el honours the mode bits in a\n")
    (insert ";; package's tarball, which overrides the caller's umask.\n")
    (insert "(defvar site--renormalized 0)\n")
    (insert "(named-let walk ((dir package-user-dir))\n")
    (insert "  (unless (eq (file-modes dir) #o2775)\n")
    (insert "    (set-file-modes dir #o2775)\n")
    (insert "    (setq site--renormalized (1+ site--renormalized)))\n")
    (insert "  (dolist (f (directory-files dir t directory-files-no-dot-files-regexp))\n")
    (insert "    (when (and (file-directory-p f) (not (file-symlink-p f)))\n")
    (insert "      (walk f))))\n\n")
    (insert "(princ (format \"\\n=== installed into %s ===\\n\" package-user-dir))\n")
    (insert "(princ (format \"directories renormalized to 2775: %d\\n\" site--renormalized))\n")
    (insert "(princ (format \"vterm-module: %s\\n\" site--vterm))\n")
    (insert "(princ (format \"skipped (not in archives): %d\\n\" (length site--skipped)))\n")
    (insert "(dolist (p (sort site--skipped #'string<)) (princ (format \"  %s\\n\" p)))\n")
    (insert "(princ (format \"failed: %d\\n\" (length site--failed)))\n")
    (insert "(dolist (p site--failed) (princ (format \"  %s: %s\\n\" (car p) (cdr p))))\n")
    (insert "\n;;; site-packages.el ends here\n"))

  (princ (format "archive from init.el   : %d\n" (length archive)))
  (princ (format "selected (custom-file) : %d\n" (length (car cl))))
  (princ (format "suppressed (:ensure nil/:disabled): %d\n" (length suppressed)))
  (princ (format "vc from init.el        : %d\n" (length init-vc)))
  (princ (format "vc from custom-file kept: %d\n" (length extra-vc)))
  (princ (format "-> archive packages    : %d\n" (length sorted)))
  (princ (format "-> git packages        : %d\n" (length init-vc)))
  (when unresolved
    (princ (format "!! DROPPED -- :vc spec yields no URL: %d\n" (length unresolved)))
    (dolist (p unresolved) (princ (format "!!   %s\n" p))))
  (princ (format "wrote                  : %s\n" out)))
