(defvar site-vc-packages
  '((org-supertag :vc-backend Git :url "https://github.com/yibie/org-supertag") (org-numbering :vc-backend Git :url "https://github.com/yibie/org-numbering") (inheritenv :vc-backend Git :url "https://github.com/purcell/inheritenv") (aidermacs :vc-backend Git :url "https://github.com/MatthewZMD/aidermacs") (stopwatch :vc-backend Git :url "https://github.com/blue0513/stopwatch") (peval :vc-backend Git :url "https://github.com/Wilfred/peval") (ct :vc-backend Git :url "https://github.com/neeasade/ct.el") (asoc :vc-backend Git :url "https://github.com/troyp/asoc.el") (vc-use-package :vc-backend Git :url "https://github.com/slotThe/vc-use-package") (dired-hist :vc-backend Git :url "https://github.com/karthink/dired-hist") (ement :vc-backend Git :url "https://github.com/alphapapa/ement.el") (orglink :vc-backend Git :url "https://github.com/tarsius/orglink") (codeium :vc-backend Git :url "https://github.com/Exafunction/codeium.el") (treesit-jump :vc-backend Git :url "https://github.com/dmille56/treesit-jump") (project-x :vc-backend Git :url "https://github.com/karthink/project-x") (outli :vc-backend Git :url "https://github.com/jdtsmith/outli") (indent-bars :vc-backend Git :url "https://github.com/jdtsmith/indent-bars")))

(package-initialize)
(package-refresh-contents)

(defvar site--skipped nil)
(defvar site--failed nil)

(dolist (pkg site-packages)
  (cond
   ((package-installed-p pkg) nil)
   ((not (assq pkg package-archive-contents))
    (push pkg site--skipped))
   (t (condition-case err
          (package-install pkg)
        (error (push (cons pkg (error-message-string err)) site--failed))))))

(dolist (spec site-vc-packages)
  (let ((name (if (consp spec) (car spec) spec)))
    (unless (package-installed-p name)
      (condition-case err
          (package-vc-install spec)
        (error (push (cons name (error-message-string err)) site--failed))))))

(princ (format "\n=== installed into %s ===\n" package-user-dir))
(princ (format "skipped (not in archives -- built-in or renamed): %d\n"
               (length site--skipped)))
(dolist (p (sort site--skipped #'string<)) (princ (format "  %s\n" p)))
(princ (format "failed: %d\n" (length site--failed)))
(dolist (p site--failed) (princ (format "  %s: %s\n" (car p) (cdr p))))

