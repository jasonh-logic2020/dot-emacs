(package-initialize)
(package-refresh-contents)

(defvar site--skipped nil)
(defvar site--failed nil)

(dolist (pkg site-packages)
  (cond
   ((package-installed-p pkg) nil)
   ((not (assq pkg package-archive-contents)) (push pkg site--skipped))
   (t (condition-case err (package-install pkg)
        (error (push (cons pkg (error-message-string err)) site--failed))))))

(dolist (spec site-vc-packages)
  (unless (package-installed-p (car spec))
    (condition-case err (package-vc-install spec)
      (error (push (cons (car spec) (error-message-string err)) site--failed)))))

(princ (format "\n=== installed into %s ===\n" package-user-dir))
(princ (format "skipped (not in archives): %d\n" (length site--skipped)))
(dolist (p (sort site--skipped #'string<)) (princ (format "  %s\n" p)))
(princ (format "failed: %d\n" (length site--failed)))
(dolist (p site--failed) (princ (format "  %s: %s\n" (car p) (cdr p))))

