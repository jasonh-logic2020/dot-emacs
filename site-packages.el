;;; site-packages.el --- host-wide Emacs package manifest -*- lexical-binding: t -*-

;; Generated from:
;;   /home/emacs/dot-emacs/init.el
;;   /home/emacs/.emacs.d/settings.el
;;
;; Candidates come from the use-package forms in init.el (excluding
;; :disabled and :ensure nil), unioned with package-selected-packages.
;; Dependencies are resolved by package.el and need not be listed.
;; Names that are built-in or absent from the archives are skipped and
;; reported at the end of the run -- prune them from this file after the
;; first pass.
;;
;; Install/refresh the host set with:
;;   sudo emacs -q --batch -l site-packages.el
;;
;; The tree is world-readable; every user's Emacs activates it via
;; `package-directory-list' (set in early-init.el).  Write access is
;; limited to the `emacs-admin' group:
;;
;;   sudo groupadd emacs-admin
;;   sudo usermod -a -G emacs-admin <user>
;;   sudo chgrp -R emacs-admin /usr/local/share/emacs/site-lisp/elpa
;;   sudo chmod -R 2775      /usr/local/share/emacs/site-lisp/elpa
;;
;; Users do NOT need group membership to use the packages -- only to
;; change the host set.  Per-user additions go to ~/.emacs.d/elpa.

(require 'package)
(require 'seq)

(setq package-user-dir "/usr/local/share/emacs/site-lisp/elpa/"
      package-gnupghome-dir nil
      package-check-signature nil
      package-archives
      '(("gnu"          . "https://elpa.gnu.org/packages/")
        ("non-gnu"      . "https://elpa.nongnu.org/nongnu/")
        ("melpa-stable" . "https://stable.melpa.org/packages/")
        ("melpa"        . "https://melpa.org/packages/"))
      package-archive-priorities
      '(("gnu" . 5) ("non-gnu" . 3) ("melpa-stable" . 2) ("melpa" . 1)))

